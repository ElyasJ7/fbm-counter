# Copy to apps/api/.env and apps/web/.env as needed.
# Never commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://fbm:fbm_dev_password@localhost:5432/fbm_counter?schema=public"

# --- API ---
API_PORT=3001
API_PREFIX=api
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cookie / session auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3001/api
