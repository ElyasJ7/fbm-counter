# Copy to apps/api/.env and apps/web/.env as needed.
# Never commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://fbm:fbm_dev_password@localhost:5432/fbm_counter?schema=public"

# --- API ---
API_PORT=3001
API_PREFIX=api
NODE_ENV=development
# Comma-separated origins allowed for credentialed CORS
CORS_ORIGIN=http://localhost:5173
# Set true behind a reverse proxy so req.ip is correct
TRUST_PROXY=false

# Cookie / session auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# In production, omit COOKIE_SECURE or set true (auto-true when NODE_ENV=production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Document storage: local (default) or s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# S3 / MinIO (when STORAGE_DRIVER=s3)
# S3_BUCKET=fbm-documents
# S3_REGION=eu-central-1
# S3_PREFIX=documents
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Demo login prefills (apps/web/.env.development only — never set in production)
# VITE_DEMO_LOGIN_EMAIL=admin@musterbau.example
# VITE_DEMO_LOGIN_PASSWORD=Admin123!
