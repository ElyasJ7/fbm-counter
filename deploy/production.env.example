# Production / Oracle Cloud Free — copy to /opt/fbm/.env (never commit).
# Generate secrets: openssl rand -base64 48

# --- Public site (same-origin cookies) ---
FBM_DOMAIN=fbm.example.com
CORS_ORIGIN=https://fbm.example.com

# --- Images (set by deploy to immutable SHA tags) ---
FBM_API_IMAGE=ghcr.io/OWNER/fbm-api:latest
FBM_WEB_IMAGE=ghcr.io/OWNER/fbm-web:latest

# --- Paths on the VM (/opt/fbm) ---
FBM_ENV_FILE=.env
FBM_DATA_DIR=./data
FBM_UPLOADS_DIR=./uploads
FBM_CADDY_DIR=./caddy
FBM_BACKUP_DIR=./backups

# --- Postgres (internal only; not published) ---
POSTGRES_DB=fbm_counter
POSTGRES_USER=fbm
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- API ---
NODE_ENV=production
API_PORT=3001
API_PREFIX=api
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-chars
# JWT_REFRESH_SECRET unused (opaque refresh tokens in DB) — omit or leave blank
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true
ALLOW_SEED=false

# Document storage: local volume (default) or s3
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
DOCUMENT_BLOB_RETENTION_DAYS=30

# S3 (only if STORAGE_DRIVER=s3) — never use default MinIO credentials
# S3_BUCKET=
# S3_REGION=
# S3_PREFIX=documents
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# FX — none | exchangerate-api | openexchangerates
FX_PROVIDER=none
# FX_API_KEY=

# First admin bootstrap (used only by create-staging-admin / create-admin script)
# STAGING_ADMIN_EMAIL=admin@your-company.example
# STAGING_ADMIN_PASSWORD=

# Company business defaults (configure in UI Settings after first login; do not
# overwrite existing DB settings blindly):
#   Language: English
#   Base / display currency: AFN
#   Also supported: USD, EUR
#   Timezone: Asia/Kabul
