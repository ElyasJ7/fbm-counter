# Staging environment — copy to deploy/staging.env (gitignored) and fill values.
# Never commit real secrets.

# Used by docker compose variable substitution + API container
STAGING_DB_PASSWORD=replace-with-strong-db-password
STAGING_WEB_ORIGIN=http://127.0.0.1:8081
STAGING_API_PUBLIC_URL=http://127.0.0.1:3002/api

# Required by API (production validator)
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Production-like cookies (browser login over plain HTTP will not persist Secure cookies;
# use HTTPS on a real host, or rely on API smoke for local staging).
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Keep false on staging after first admin is created
ALLOW_SEED=false

STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
DOCUMENT_BLOB_RETENTION_DAYS=30

# FX: none (manual rates) or exchangerate-api / openexchangerates + FX_API_KEY
FX_PROVIDER=none
# FX_API_KEY=
